# Example environment for swift-server-foundation.
#
# Format: institute dotenv (`Environment.Dotenv`, swift-environment).
# Key grammar: [A-Za-z_][A-Za-z0-9_.]* — hyphens are NOT valid in keys.
#
# STRUCTURAL GAP (pending ruling, W3-overnight lane M): the legacy contract
# carried three hyphenated keys that the institute dotenv grammar cannot
# represent; they are parked here as comments. Consumers reading them via
# `EnvVars` currently get nil from file-based loading:
#   LOCAL-SSL-SERVER-CRT="-----BEGIN CERTIFICATE-----\nMIIBkTCB+wIJAMIyt...\n-----END CERTIFICATE-----"
#   LOCAL-SSL-SERVER-KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkq...\n-----END PRIVATE KEY-----"
#   APPLE-DEVELOPER-MERCHANTID-DOMAIN-ASSOCIATION="apple-developer-merchantid-domain-association-content"

ALLOWED_INSECURE_HOSTS="127.0.0.1, 0.0.0.0, localhost"
APP_ENV="development"
APP_SECRET="deadbeefdeadbeefdeadbeefdeadbeef"
BASE_URL="http://localhost:8080"
CANONICAL_HOST="localhost:8080"
DEMO_NAME="Example"
DEMO_EMAIL="example@example.com"
DEMO_PASSWORD="12345678"
DEMO_STRIPE_CUSTOMER_ID="cus_zzzzzzzzzzz"
DATABASE_URL="postgres://admin:@localhost:5432/example-com-server-development"
EMERGENCY_MODE="0"
GOOGLE_ANALYTICS_ID="G-A11AAA111A"
HOTJAR_ANALYTICS_ID="1111111"
HTTPS_REDIRECT="true"
COMPANY_NAME="example"
COMPANY_INFO_EMAIL_ADDRESS="info@example.com"
COMPANY_X_COM_HANDLE="example"
COMPANY_GITHUB_HANDLE="example"
COMPANY_LINKEDIN_HANDLE="example"
LANGUAGES="en, nl"
LOG_LEVEL="debug"
MAILGUN_BASE_URL="https://api.mailgun.net"
MAILGUN_PRIVATE_API_KEY="zzzzzzzzzzzzzzzzzzzzzzzz"
MAILGUN_DOMAIN="sandboxzzzzzzzzzzzzzzzzzzzzzzzz.mailgun.org"
MAILGUN_WEBHOOK_SIGNING_KEY="zzzzzzzzzzzzzzzzzzzzzzzz"
MAILGUN_COMPANY_EMAIL="mailgun@example.com"
PORT="8080"
SESSION_COOKIE_NAME="example_session"
STRIPE_ENDPOINT_SECRET="whsec_zzzzzzzzzzzzzzzzzzzzzzzz"
STRIPE_PUBLISHABLE_KEY="pk_test_zzzzzzzzzzzzzzzzzzzzzzzz"
STRIPE_SECRET_KEY="sk_test_zzzzzzzzzzzzzzzzzzzzzzzz"
TAXIDENTIFICATIONNUMBER="NL001111111111111"
